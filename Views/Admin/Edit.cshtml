@model EditUserViewModel

@{
    ViewData["Title"] = "Edit user";
    var roles = (SelectList)ViewData["Roles"];
    var buyerTypes = (SelectList)ViewData["BuyerTypes"];
}

<h1>Edit user</h1>

<h4>@Model.Email</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Role" class="control-label"></label>
                <select asp-for="Role" class="form-control" asp-items="roles"></select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BuyerType" class="control-label"></label>
                <select asp-for="BuyerType" class="form-control" asp-items="buyerTypes"></select>
                <span asp-validation-for="BuyerType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
